{
  "name": "web-rotate-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing websearch and webfetch tools backed by web-rotate-core provider rotation",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "web-rotate-mcp": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "web-rotate-core": "github:Sn0wo2/web-rotate-core"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2"
  }
}
